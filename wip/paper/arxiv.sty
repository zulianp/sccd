%% arxiv.sty -- a plain preprint style for a single-column arXiv submission.
%%
%% Self-contained on purpose: everything it needs is in a standard TeX Live, so
%% the article builds on arXiv's compiler and on a machine that has never seen
%% this directory. It provides a title block that carries several authors across
%% several institutions, a narrowed abstract, a running header and \keywords.
%%
%% Load it after the document class and before hyperref.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arxiv}[2026/09/12 Preprint style]

\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{xcolor}

\geometry{letterpaper, textwidth=6.0in, textheight=8.9in,
          top=1.25in, left=1.25in, footskip=0.6in, headsep=0.25in}

% --- running header --------------------------------------------------------
% The preprint mark is set by \preprintmark; it is deliberately not a journal
% name, because this is not one.
\newcommand{\@preprintmark}{\textsc{A preprint}}
\newcommand{\preprintmark}[1]{\renewcommand{\@preprintmark}{#1}}
\newcommand{\@runningtitle}{}
\newcommand{\headertitle}[1]{\renewcommand{\@runningtitle}{#1}}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\fancyhead[L]{\footnotesize\@preprintmark}
\fancyhead[R]{\footnotesize\itshape\@runningtitle}
\fancyfoot[C]{\thepage}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\thepage}}

% --- title block -----------------------------------------------------------
% \author takes a list of \Author entries; affiliations are numbered marks
% declared with \affiltext and referenced with \affilmark, so eight authors
% across six institutions fit without a package.
\newcommand{\affilmark}[1]{\textsuperscript{\normalfont #1}}
\newcounter{arxiv@affil}
\newcommand{\affiltext}[2]{%
  \par\noindent\makebox[1.2em][l]{\textsuperscript{#1}}\ignorespaces #2\par}

% `article` defines \and through a tabular, which a title block not built from
% one cannot use -- it expands to a stray \crcr, and so does \and anywhere else,
% such as in a keyword list. In a preprint both run as a sentence, so \and
% becomes a separator with a little air.
\renewcommand{\and}{\unskip,\hskip 0.55em plus 0.2em\ignorespaces}

\renewcommand{\maketitle}{%
  \thispagestyle{plain}%
  \renewcommand{\thefootnote}{\fnsymbol{footnote}}%
  \begin{center}%
    {\LARGE\bfseries\@title\par}%
    \vskip 1.1em%
    {\normalsize\@author\par}%
    \vskip 0.9em%
    {\footnotesize\begin{minipage}{0.92\textwidth}\raggedright\@affiliations\end{minipage}\par}%
    \vskip 0.6em%
    {\footnotesize\@date\par}%
  \end{center}%
  % \thanks queues its text here; without this the mark on the byline points at
  % a footnote that is never set.
  \@thanks\global\let\@thanks\@empty
  \vskip 1.2em%
}

\newcommand{\@affiliations}{}
\newcommand{\affiliations}[1]{\renewcommand{\@affiliations}{#1}}

% --- abstract and keywords -------------------------------------------------
\renewenvironment{abstract}{%
  \centerline{\large\bfseries Abstract}%
  \begin{quotation}\noindent\small\ignorespaces
}{%
  \end{quotation}%
}

\newcommand{\keywords}[1]{%
  \vskip 0.2em%
  \begin{quotation}\noindent\small\textbf{Keywords:} #1\end{quotation}%
  \vskip 0.8em%
}

% --- sectioning ------------------------------------------------------------
\titleformat{\section}{\large\bfseries}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{1.4ex plus .6ex minus .2ex}{0.8ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.1ex plus .5ex minus .2ex}{0.6ex plus .2ex}

\endinput
