# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# debug information files
*.dwo

# ---------------------------------------------------------------------------
# Build trees. Several coexist (release, debug, cuda, benchmark, ...), all
# matching build*, and none of them belong in the repository.
build*/

# Benchmark and analysis output. These are regenerated by the drivers in
# benchmark/ and scripts/, and data/ alone is several gigabytes of meshes.
data/
csv/
benchmark/alps/
benchmark/reports/
# Ignore the contents rather than the directory itself, so a README explaining
# what lands there can still be tracked -- git does not descend into an ignored
# directory, and a negation inside one never fires.
**/figures/*
!**/figures/README.md
*.csv
# Two exceptions: CSVs that are inputs or evidence rather than output -- the
# oracle's query sets, and the measurement tables their write-ups cite.
!benchmark/oracle/*.csv
!benchmark/assessment/*.csv
!research/notebook/**/*.csv
*.pdf
*.aux
*.log
*.tar.gz

# docs/ holds both written documentation and rendered output; keep the writing.
docs/*
!docs/*.md

# Python bytecode and macOS directory metadata.
__pycache__/
*.pyc
.DS_Store

# Editor state.
.vscode/

# A stray backup next to the translation unit it was copied from still ends in
# .cu, so a glob build compiles both and every symbol is defined twice.
*.bkp.*

# Generated reports: HTML and LaTeX rendered from the benchmark CSVs.
*.html
*.tex

# Nsight Compute profiles.
*.ncu-rep

# Mesh frames dropped next to the benchmarks, one directory per frame.
benchmark/[0-9]*/
benchmark/cloth_ball[0-9]*/

# Oracle output. The query sets and the write-up are tracked (see
# benchmark/oracle/README.md, which defines the correctness contract); the
# violation dumps and per-run directories are regenerated on every gate run.
benchmark/oracle/violations-*.csv
benchmark/oracle/run/
benchmark/oracle/postfix/

# Figures rendered by the analysis scripts.
*.png

# Build trees, wherever they are dropped.
build*/

# Stray output at the repository root: rendered reports, plots, logs, traces.
/*.html
/*.log
/*.png
/*.csv
/*.tar.gz
.DS_Store
